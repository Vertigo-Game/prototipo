d="c95" value="quique ←" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220.0" y="226.0" as="sourcePoint"/><mxPoint x="130.0" y="162.0" as="targetPoint"/><Array as="points"><mxPoint x="180.0" y="138.0"/></Array></mxGeometry></mxCell><mxCell id="c96" value="inimigo móvel" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="194.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c97" value="← saída" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34.0" y="132.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c98" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320.0" y="586.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c99" value="espinhos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90.0" y="398.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c100" value="espinhos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="374.0" y="126.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c101" value="pedra fixa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="404.0" y="386.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;Objetivo:&lt;/b&gt; Subida com ponto móvel, pedra fixa, outro ponto móvel fora de fase e um inimigo móvel no fim, com espinhos nas paredes.&lt;br&gt;&lt;br&gt;• Chão 2 com fogueira (cair na chaminé só faz recomeçar a subida), paredes com espinhos nas faces de dentro.&lt;br&gt;• A (45°) leva até a ponta de cima, onde a pedra fixa (18; 12,5) entra no alcance (4,0).&lt;br&gt;• Da pedra, B (135°) só fica ao alcance (2,8) quando está embaixo; B começa no meio da rota (progresso 0,5) para não andar junto com A.&lt;br&gt;• Na pedra o jogador fica parado, preso pelas mãos: dá para esperar B com calma antes de seguir.&lt;br&gt;• No alto de B o inimigo móvel passa 2 acima (perto, sem encostar): enganchar e quicar segurando ← para cair na saída (chão 25).&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel A (prefab PontoMovel, Stop At Anchor ligado) em (10,25; 9,25): Definir Por Angulo ligado, ângulo 45, comprimento 10,61, velocidade 3, pausa 0,5.&lt;br&gt;• PontoMovel B (prefab PontoMovel, Stop At Anchor ligado) em (13; 17): Definir Por Angulo ligado, ângulo 135, comprimento 8,49, velocidade 3, pausa 0,5, progresso inicial 0,5.&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (18; 12,5).&lt;br&gt;• Inimigo móvel (prefab InimigoMovel) em (12; 21,5): por ângulo, ângulo 0, comprimento 6, velocidade 2, trilho desligado.&lt;br&gt;• Fogueira (checkpoint) no chão em x 18.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="700.0" width="560.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="Passo 6 — Subir a corda para pegar a carona"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 6 — Subir a corda para pegar a carona" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;