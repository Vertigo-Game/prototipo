eometry x="370.0" y="357.0" width="20.0" height="13.0" as="geometry"/></mxCell><mxCell id="c47" value="" style="triangle;direction=north;html=1;fillColor=#D9483B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="390.0" y="357.0" width="20.0" height="13.0" as="geometry"/></mxCell><mxCell id="c48" value="" style="triangle;direction=north;html=1;fillColor=#D9483B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="410.0" y="357.0" width="20.0" height="13.0" as="geometry"/></mxCell><mxCell id="c49" value="" style="triangle;direction=north;html=1;fillColor=#D9483B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="430.0" y="357.0" width="20.0" height="13.0" as="geometry"/></mxCell><mxCell id="c50" value="" style="triangle;direction=north;html=1;fillColor=#D9483B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="450.0" y="357.0" width="20.0" height="13.0" as="geometry"/></mxCell><mxCell id="c51" value="" style="triangle;direction=north;html=1;fillColor=#D9483B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470.0" y="357.0" width="20.0" height="13.0" as="geometry"/></mxCell><mxCell id="c52" value="" style="ellipse;html=1;fillColor=none;strokeColor=#3D6FD6;dashed=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="120.0" width="200.0" height="200.0" as="geometry"/></mxCell><mxCell id="c53" value="alcance 5 (preso no ponto)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#3D6FD6;" vertex="1" parent="1"><mxGeometry x="282.0" y="140.0" width="140.0" height="16.0" as="geometry"/></mxCell><mxCell id="c54" value="" style="endArrow=oval;startArrow=oval;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#8D8E8F;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="210.0" as="sourcePoint"/><mxPoint x="350.0" y="210.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="" style="ellipse;html=1;fillColor=#F2C94C;strokeColor=#5c5d5e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="102.5" y="202.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c56" value="PontoMovel · v 2,5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190.0" y="189.0" width="150.0" height="16.0" as="geometry"/></mxCell><mxCell id="c57" value="" style="ellipse;html=1;fillColor=#E39B2D;strokeColor=#6b4e16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="402.5" y="182.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c58" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="103.0" y="282.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c59" value="gancho" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="118.0" y="286.0" as="sourcePoint"/><mxPoint x="112.0" y="224.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="carona" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="226.0" as="sourcePoint"/><mxPoint x="340.0" y="226.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="solta e mira no ar" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="358.0" y="250.0" as="sourcePoint"/><mxPoint x="402.0" y="200.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="pula ou dash" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="418.0" y="206.0" as="sourcePoint"/><mxPoint x="510.0" y="234.0" as="targetPoint"/><Array as="points"><mxPoint x="460.0" y="178.0"/></Array></mxGeometry></mxCell><mxCell id="c63" value="17" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490.0" y="340.0" as="sourcePoint"/><mxPoint x="150.0" y="340.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="pedra fixa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="382.0" y="154.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Objetivo:&lt;/b&gt; Combinar com o gancho já conhecido: o ponto móvel leva o jogador até onde a pedra fixa entra no alcance.&lt;br&gt;&lt;br&gt;• Início chão 4 (0–5), vão com espinhos (6–22), chegada chão 7 (23–35).&lt;br&gt;• A pedra fixa (19; 10) só fica a menos de 5 quando o ponto móvel está na ponta direita.&lt;br&gt;• Do início ela está a 15: não dá para pular etapa.&lt;br&gt;• Para trocar de alvo: apertar o gancho solta, apertar de novo no ar mira (o tempo desacelera).&lt;br&gt;• Na pedra o jogador fica parado, preso pelas mãos; sai com pulo ou dash para a chegada.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (10; 9): Definir Por Angulo ligado, ângulo 0, comprimento 12, velocidade 2,5, pausa 1.&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (19; 10).&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="420.0" width="720.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="Passo 4b — Pular do ponto e dar dash"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 4b — Pular do ponto e dar dash" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="680.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="680.0" height="320.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="350.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B5563;align=center;" vertex="1" parent="1"><mxGeometry x="15.0" y="352.0" width="30.0" height="16.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="30.0" as="sourcePoint"/><mxPoint x="130.0" y="350.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B5563;align=center;" vertex="1" parent="1"><mxGeometry x="115.0" y="352.0" width="30.0" height="16.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mx