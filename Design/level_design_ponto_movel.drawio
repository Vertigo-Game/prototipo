id="c29" value="" style="rounded=0;html=1;fillColor=#F7FAFD;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="410.0" width="220.0" height="5.0" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=0;html=1;fillColor=#F7FAFD;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="250.0" y="130.0" width="300.0" height="5.0" as="geometry"/></mxCell><mxCell id="c31" value="" style="ellipse;html=1;fillColor=none;strokeColor=#3D6FD6;dashed=1;" vertex="1" parent="1"><mxGeometry x="50.0" y="110.0" width="200.0" height="200.0" as="geometry"/></mxCell><mxCell id="c32" value="alcance 5 (no alto)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#3D6FD6;" vertex="1" parent="1"><mxGeometry x="82.0" y="130.0" width="140.0" height="16.0" as="geometry"/></mxCell><mxCell id="c33" value="" style="endArrow=oval;startArrow=oval;endFill=1;startFill=1;endSize=5;startSize=5;html=1;strokeColor=#8D8E8F;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="340.0" as="sourcePoint"/><mxPoint x="150.0" y="200.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="" style="ellipse;html=1;fillColor=#F2C94C;strokeColor=#5c5d5e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="142.5" y="332.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c35" value="PontoMovel · v 2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="162.0" y="262.0" width="150.0" height="16.0" as="geometry"/></mxCell><mxCell id="c36" value="" style="ellipse;html=1;fillColor=#F28C28;strokeColor=#D62828;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="211.0" y="181.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83.0" y="382.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c38" value="gancho" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="156.0" y="386.0" as="sourcePoint"/><mxPoint x="154.0" y="350.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="sobe" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="346.0" as="sourcePoint"/><mxPoint x="140.0" y="214.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="solta e engancha" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="158.0" y="206.0" as="sourcePoint"/><mxPoint x="212.0" y="194.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="quique" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="224.0" y="178.0" as="sourcePoint"/><mxPoint x="280.0" y="118.0" as="targetPoint"/><Array as="points"><mxPoint x="240.0" y="102.0"/></Array></mxGeometry></mxCell><mxCell id="c42" value="+14" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50.0" y="410.0" as="sourcePoint"/><mxPoint x="50.0" y="130.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="inimigo (só com gancho)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="162.0" y="146.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Objetivo:&lt;/b&gt; Combinar com o inimigo: o ponto sobe, o jogador solta e engancha no inimigo para quicar até a borda alta.&lt;br&gt;&lt;br&gt;• Chão seguro 3 (0–10), parede alta chão 17 (11–25).&lt;br&gt;• O inimigo (9,5; 14) só fica ao alcance com o ponto lá em cima; do chão está a 10,6.&lt;br&gt;• O quique sobe ~4.6 acima do inimigo: passa da borda (17) com folga.&lt;br&gt;• O trilho passa a 3,5 do inimigo: encostar nele continua matando, então o jogador nunca encosta sem querer.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (6; 10): Definir Por Angulo ligado, ângulo 90, comprimento 7, velocidade 2, pausa 1.&lt;br&gt;• Inimigo parado (prefab EnemyHookPoint) em (9,5; 14)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="500.0" width="560.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="Passo 4d — Pedra fixa → ponto móvel → inimigo"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 4d — Pedra fixa → ponto móvel → inimigo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="680.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="680.0" height="400.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mx