C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="122.0" y="206.0" as="sourcePoint"/><mxPoint x="182.0" y="162.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c67" value="" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="198.0" y="154.0" as="sourcePoint"/><mxPoint x="272.0" y="144.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="288.0" y="146.0" as="sourcePoint"/><mxPoint x="362.0" y="152.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378.0" y="154.0" as="sourcePoint"/><mxPoint x="452.0" y="144.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="468.0" y="146.0" as="sourcePoint"/><mxPoint x="542.0" y="152.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value="solta" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558.0" y="158.0" as="sourcePoint"/><mxPoint x="610.0" y="214.0" as="targetPoint"/><Array as="points"><mxPoint x="586.0" y="178.0"/></Array></mxGeometry></mxCell><mxCell id="c72" value="preso numa pedra, o vento não empurra" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210.0" y="66.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c73" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="614.0" y="182.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;Objetivo:&lt;/b&gt; Vento contra + pedras fixas: preso numa pedra o vento não age, então o caminho é de pedra em pedra, sem soltar no meio.&lt;br&gt;&lt;br&gt;• Início e chegada chão 6 (0–4 e 28–33); vão com espinhos (5–27).&lt;br&gt;• O vento (direita → esquerda, x 5 a 25, y 6 a 12) empurra para trás quem está no ar.&lt;br&gt;• Pedras a 4,5–4,6 uma da outra: ir de uma em uma. Soltar no meio do vento leva de volta para os espinhos.&lt;br&gt;• A última pedra (26; 10) já está fora do vento: dali é só soltar e cair na chegada.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (8; 10).&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (12,5; 10,5).&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (17; 10).&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (21,5; 10,5).&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (26; 10).&lt;br&gt;• Fogueira (checkpoint) no chão em x 31.&lt;br&gt;• Vento Vento_Contra (prefab WindArea) em (25; 9): Origin Direita → Esquerda, width 20, height 6, strength 30, launch speed 6, max speed 10.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="380.0" width="680.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p17" name="Passo 14 — Corrente + ponto móvel"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 14 — Corrente + ponto móvel" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="760.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="760.0" height="440.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="470.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B5563;align=center;" vertex="1" parent="1"><mxGeometry x="15.0" y="472.0" width="30.0" height="16.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="30.0" as="sourcePoint"/><mxPoint x="130.0" y="470.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B5563;align=center;" vertex="1" parent="1"><mxGeometry x="115.0" y="472.0" width="30.0" height="16.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230.0" y="30.0" as="sourceP