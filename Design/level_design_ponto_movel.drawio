lor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="152.0" y="338.0" as="sourcePoint"/><mxPoint x="152.0" y="190.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="gancho" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="146.0" y="166.0" as="sourcePoint"/><mxPoint x="174.0" y="114.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="carona" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200.0" y="118.0" as="sourcePoint"/><mxPoint x="530.0" y="118.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" value="solta" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="542.0" y="114.0" as="sourcePoint"/><mxPoint x="610.0" y="154.0" as="targetPoint"/><Array as="points"><mxPoint x="574.0" y="102.0"/></Array></mxGeometry></mxCell><mxCell id="c66" value="corda presa na laje" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36.0" y="46.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c67" value="espinhos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310.0" y="346.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Objetivo:&lt;/b&gt; Corda + ponto móvel: o ponto só fica ao alcance do alto da corda. Subir na hora certa e pegar a carona sobre os espinhos.&lt;br&gt;&lt;br&gt;• Chão 2 (0–33) com espinhos de 9 a 27; laje no alto (3–6, 13–14) segurando a corda; chegada chão 13 (28–33).&lt;br&gt;• Do alto da corda o ponto está a 4,3; de baixo da corda, a 13: precisa subir.&lt;br&gt;• Sem a corda não há como chegar: o ponto passa a 14 do chão.&lt;br&gt;• Preso, o jogador fica a 16 (pés a 15,3), acima da chegada (13): no fim é só soltar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (16,5; 16,5): Definir Por Angulo ligado, ângulo 0, comprimento 18, velocidade 2,5, pausa 1.&lt;br&gt;• Corda no tilemap rope_climb, coluna x 5, de y 3 a 12 (o tilemap precisa do componente Corda).&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="460.0" width="680.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="Passo 7 — Esperar na pedra o inimigo chegar"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 7 — Esperar na pedra o inimigo chegar" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="680.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="680.0" height="360.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="390.0" as="targetPoin