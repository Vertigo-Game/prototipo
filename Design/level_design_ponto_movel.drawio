yle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="482.0" y="218.0" as="sourcePoint"/><mxPoint x="660.0" y="218.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c97" value="inimigo" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="676.0" y="212.0" as="sourcePoint"/><mxPoint x="722.0" y="242.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c98" value="quique no vento" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="736.0" y="234.0" as="sourcePoint"/><mxPoint x="882.0" y="178.0" as="targetPoint"/><Array as="points"><mxPoint x="770.0" y="158.0"/></Array></mxGeometry></mxCell><mxCell id="c99" value="espinhos em todo o vão" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430.0" y="466.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c100" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="886.0" y="130.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c101" value="inimigo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="694.0" y="270.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;Objetivo:&lt;/b&gt; Tudo junto: corrente para cima, pedras contra o vento, ponto móvel, quique no inimigo e faixa de vento até a fogueira.&lt;br&gt;&lt;br&gt;• Início chão 3 com fogueira (0–7), vão com espinhos (8–39), chegada chão 18 (40–47) com fogueira.&lt;br&gt;• A corrente (x 4 a 7, y 3 a 12) leva até ~14,3; dali a primeira pedra (9; 17) está a 4,4.&lt;br&gt;• Pedras a 4,5–4,6 dentro do vento contra (x 11 a 24, y 15 a 20): soltar no meio leva de volta para trás.&lt;br&gt;• Da última pedra, o ponto móvel só está ao alcance na ponta esquerda (4,3). Na ponta direita, o inimigo (35; 15) fica a 3,9.&lt;br&gt;• O quique sobe ~4,6 e entra na faixa de vento (x 34 a 44, y 18 a 21), que leva até a chegada. Sem o vento, ele cai antes da borda.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (27; 18): Definir Por Angulo ligado, ângulo 0, comprimento 10, velocidade 2,5, pausa 0,8.&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (9; 17).&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (13,5; 17,5).&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (18; 17).&lt;br&gt;• Inimigo parado (prefab EnemyHookPoint) em (35; 15).&lt;br&gt;• Fogueira (checkpoint) no chão em x 1.&lt;br&gt;• Fogueira (checkpoint) no chão em x 45.&lt;br&gt;• Vento Vento_Subida (prefab WindArea) em (5,5; 3): Origin Baixo → Cima, width 3, height 9, strength 35, launch speed 11,5, max speed 14,2.&lt;br&gt;• Vento Vento_Contra (prefab WindArea) em (24; 17,5): Origin Direita → Esquerda, width 13, height 5, strength 30, launch speed 6, max speed 10.&lt;br&gt;• Vento Vento_Lateral (prefab WindArea) em (34; 19,5): Origin Esquerda → Direita, width 10, height 3, strength 30, launch speed 12, max speed 15.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="580.0" width="960.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>