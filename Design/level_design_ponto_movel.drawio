="382.0" as="sourcePoint"/><mxPoint x="102.0" y="390.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="sobe" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="382.0" as="sourcePoint"/><mxPoint x="120.0" y="234.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value="gancho" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="128.0" y="218.0" as="sourcePoint"/><mxPoint x="130.0" y="166.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c72" value="carona" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="166.0" as="sourcePoint"/><mxPoint x="580.0" y="166.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c73" value="pula →" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="598.0" y="158.0" as="sourcePoint"/><mxPoint x="662.0" y="158.0" as="targetPoint"/><Array as="points"><mxPoint x="626.0" y="130.0"/></Array></mxGeometry></mxCell><mxCell id="c74" value="espinhos em todo o vão" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310.0" y="386.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c75" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690.0" y="126.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;Objetivo:&lt;/b&gt; A corrente para cima leva o jogador até o alcance de um ponto móvel lá no alto; pegar o ponto na hora em que ele passa.&lt;br&gt;&lt;br&gt;• Chão seguro 3 (0–6), vão com espinhos (7–30), chegada chão 15 (31–37).&lt;br&gt;• Só a corrente (x 3 a 6, y 3 a 10) leva até o alcance do ponto (3,7 no pico); do chão ele está a 12.&lt;br&gt;• O ponto (velocidade 3, trilho de 23) precisa estar na ponta esquerda quando o jogador chega no alto: olhar o ritmo antes de entrar no vento.&lt;br&gt;• Na ponta direita, pulo para a chegada (pés a 14,8, borda a 15).&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (16,5; 16): Definir Por Angulo ligado, ângulo 0, comprimento 23, velocidade 3, pausa 1.&lt;br&gt;• Fogueira (checkpoint) no chão em x 35.&lt;br&gt;• Vento Vento_Subida (prefab WindArea) em (4,5; 3): Origin Baixo → Cima, width 3, height 7, strength 35, launch speed 11,5, max speed 14,2.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="500.0" width="760.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p18" name="Passo 15 — Quique no vento"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 15 — Quique no vento" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="720.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" ver