D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="210.0" y="250.0" width="20.0" height="5.0" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=0;html=1;fillColor=#F7FAFD;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="230.0" width="180.0" height="5.0" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=0;html=1;fillColor=#F7FAFD;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="390.0" y="230.0" width="240.0" height="5.0" as="geometry"/></mxCell><mxCell id="c33" value="Vento_Brisa →" style="rounded=0;html=1;fillColor=#BFE3FF;opacity=60;strokeColor=#5FA8DD;dashed=1;fontSize=11;fontColor=#1F5C8A;verticalAlign=top;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="170.0" y="150.0" width="240.0" height="80.0" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="123.0" y="202.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c35" value="pula no vento" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="178.0" y="202.0" as="sourcePoint"/><mxPoint x="406.0" y="218.0" as="targetPoint"/><Array as="points"><mxPoint x="270.0" y="138.0"/></Array></mxGeometry></mxCell><mxCell id="c36" value="9 (pulo + dash ≈ 7,6)" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="118.0" as="sourcePoint"/><mxPoint x="390.0" y="118.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="fosso seguro" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250.0" y="246.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Objetivo:&lt;/b&gt; Apresentar o vento sem risco: uma brisa a favor leva o jogador por um vão que ele não passaria sozinho.&lt;br&gt;&lt;br&gt;• Bordas chão 4 (0–8 e 18–29), degrau 3 (9), fosso seguro 2 (10–17).&lt;br&gt;• Sem vento, nem pulo + dash (~7,6) passa os 9 do vão.&lt;br&gt;• A brisa (esquerda → direita, de x 7 a 19, y 4 a 8) lança o jogador a 12–16 por segundo: um pulo comum atravessa.&lt;br&gt;• Quem cai no fosso volta pelo degrau e tenta de novo. Ajuste a força no teste se o pulo passar longe demais.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• Vento Vento_Brisa (prefab WindArea) em (7; 6): Origin Esquerda → Direita, width 12, height 4, strength 30, launch speed 12, max speed 16." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="340.0" width="600.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15" name="Passo 12 — Corrente para cima"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 12 — Corrente para cima" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="520.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="520.0" height="360.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="390.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6"