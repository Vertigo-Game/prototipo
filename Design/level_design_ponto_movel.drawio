=#FF5A8C;strokeWidth=2;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="170.0" as="sourcePoint"/><mxPoint x="370.0" y="170.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="" style="ellipse;html=1;fillColor=#F28C28;strokeColor=#D62828;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="312.0" y="162.0" width="16.0" height="16.0" as="geometry"/></mxCell><mxCell id="c50" value="" style="ellipse;html=1;fillColor=#E39B2D;strokeColor=#6b4e16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="192.5" y="212.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c51" value="" style="triangle;direction=north;html=1;fillColor=#FF7A1A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="622.0" y="92.0" width="16.0" height="18.0" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="103.0" y="282.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c53" value="pedra" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="286.0" as="sourcePoint"/><mxPoint x="192.0" y="230.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="espera o inimigo" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="222.0" as="sourcePoint"/><mxPoint x="264.0" y="180.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="quique + dash →" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="278.0" y="158.0" as="sourcePoint"/><mxPoint x="422.0" y="98.0" as="targetPoint"/><Array as="points"><mxPoint x="320.0" y="78.0"/></Array></mxGeometry></mxCell><mxCell id="c56" value="7" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="270.0" as="sourcePoint"/><mxPoint x="410.0" y="270.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="inimigo móvel" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300.0" y="134.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c58" value="pedra fixa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="174.0" y="184.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c59" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590.0" y="66.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Objetivo:&lt;/b&gt; Pedra fixa como lugar de espera: pendurado parado, o jogador espera o inimigo móvel vir até o alcance e quica nele até a borda alta.&lt;br&gt;&lt;br&gt;• Início chão 4 (0–5), poço com espinhos (6–18), borda alta chão 14 (19–33).&lt;br&gt;• Da beirada só a pedra fixa (8,5; 8,5) está ao alcance (4,9). Nela o jogador fica parado, sem gastar nada.&lt;br&gt;• O inimigo anda de 12 a 17: só fica ao alcance da pedra (4,6) na ponta esquerda.&lt;br&gt;• O quique leva o jogador a ~14,9 (pés) e a ~5 para a direita; o dash completa até a borda (7 do inimigo).&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (8,5; 8,5).&lt;br&gt;• Inimigo móvel (prefab InimigoMovel) em (14,5; 11): por ângulo, ângulo 0, comprimento 5, velocidade 2, trilho desligado.&lt;br&gt;• Fogueira (checkpoint) no chão em x 30.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="420.0" width="680.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="Passo 8 — Corredor de pontos"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 8 — Corredor de pontos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="880.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="880.0" height="520.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="550.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B5563;align=center;" vertex="1" parent="1"><mxGeometry x="15.0" y="552.0" width="30.0" height="16.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="30.0" as="sourcePoint"/><mxPoint x="130.0" y="550.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="5" style=