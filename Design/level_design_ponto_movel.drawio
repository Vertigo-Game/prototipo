"16.0" height="18.0" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83.0" y="282.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c67" value="pedra" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="118.0" y="286.0" as="sourcePoint"/><mxPoint x="182.0" y="242.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="espera o ponto" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="202.0" y="274.0" as="sourcePoint"/><mxPoint x="242.0" y="224.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="carona" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="262.0" y="226.0" as="sourcePoint"/><mxPoint x="440.0" y="226.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="inimigo" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="458.0" y="250.0" as="sourcePoint"/><mxPoint x="520.0" y="218.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value="quique →" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536.0" y="194.0" as="sourcePoint"/><mxPoint x="610.0" y="136.0" as="targetPoint"/><Array as="points"><mxPoint x="560.0" y="118.0"/></Array></mxGeometry></mxCell><mxCell id="c72" value="pedra fixa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="202.0" y="194.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c73" value="inimigo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="498.0" y="166.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c74" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="618.0" y="94.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Objetivo:&lt;/b&gt; As três coisas em sequência, sem tocar o chão: esperar o ponto móvel pendurado numa pedra fixa e terminar quicando no inimigo.&lt;br&gt;&lt;br&gt;• Início chão 6 (0–4), vão com espinhos (5–27), chegada chão 14 (28–33).&lt;br&gt;• Da beirada só a pedra fixa (8; 10) está ao alcance (4,8); o ponto móvel está a 7,8.&lt;br&gt;• Preso na pedra, o ponto móvel só entra no alcance (3,4) quando está na ponta esquerda: espera nele.&lt;br&gt;• Na ponta direita do trilho o inimigo (25; 11) fica a 4,0; o quique sobe ~4,6 e passa da borda (14).&lt;br&gt;• Fogueira na chegada, antes da prova.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (16; 11): Definir Por Angulo ligado, ângulo 0, comprimento 10, velocidade 2,5, pausa 0,8.&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (8; 10).&lt;br&gt;• Inimigo parado (prefab EnemyHookPoint) em (25; 11).&lt;br&gt;• Fogueira (checkpoint) no chão em x 31.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="460.0" width="680.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="Passo 5 — Prova: a chaminé"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 5 — Prova: a chaminé" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="480.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="480.0" height="640.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="670.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B5563;align=center;" vertex="1" parent="1"><mxGeometry x="15.0" y="672.0" width="30.0" height="16.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="30.0" as="sourcePoint"/><mxPoint x="130.0" y="670.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B5563;align=center;" vertex="1" parent="1"><mxGeometry x="115.0" y="672.0" width="30.0" height="16.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=