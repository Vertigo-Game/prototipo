rtex="1" parent="1"><mxGeometry x="112.5" y="112.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c66" value="PontoMovel · v 3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340.0" y="99.0" width="150.0" height="16.0" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="83.0" y="202.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c68" value="gancho" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="118.0" y="206.0" as="sourcePoint"/><mxPoint x="120.0" y="134.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="carona" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="136.0" as="sourcePoint"/><mxPoint x="630.0" y="136.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="pula →" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642.0" y="132.0" as="sourcePoint"/><mxPoint x="710.0" y="134.0" as="targetPoint"/><Array as="points"><mxPoint x="670.0" y="94.0"/></Array></mxGeometry></mxCell><mxCell id="c71" value="2,5" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640.0" y="220.0" as="sourcePoint"/><mxPoint x="690.0" y="220.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c72" value="espinhos em todo o vão" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310.0" y="286.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;Objetivo:&lt;/b&gt; Ficar preso no ponto enquanto ele atravessa um vão longo e pular para a chegada no fim.&lt;br&gt;&lt;br&gt;• Início chão 6 (0–5), vão com espinhos (6–32), chegada chão 10 (33–39).&lt;br&gt;• Preso, o jogador fica a 11 (pés a 10,3), logo acima da chegada (10), que começa 2,5 à direita do fim do trilho.&lt;br&gt;• No fim do trilho o ponto para 0,6 s: um pulo para a direita alcança a chegada.&lt;br&gt;• Velocidade 3 e pausa curta (0,6 s): dá tempo, mas pede atenção.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (17,5; 11,5): Definir Por Angulo ligado, ângulo 0, comprimento 26, velocidade 3, pausa 0,6.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="380.0" width="800.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Passo 4a — Ponto móvel leva até a pedra fixa"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 4a — Ponto móvel leva até a pedra fixa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="720.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.