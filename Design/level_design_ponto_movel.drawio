y="178.0" as="sourcePoint"/><mxPoint x="450.0" y="178.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="vem do buraco do topo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36.0" y="34.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c44" value="fosso seguro" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270.0" y="186.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c45" value="platô" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470.0" y="106.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Objetivo:&lt;/b&gt; Mostrar que o ponto anda e que o trilho diz para onde. Sem risco: cair só faz voltar pelo degrau.&lt;br&gt;&lt;br&gt;• Borda esquerda chão 6, degrau 5, fosso 4, platô 8 (colunas 0–7, 8, 9–20, 21–29).&lt;br&gt;• Do fosso o ponto fica fora do alcance: o jogador volta pelo degrau e tenta de novo.&lt;br&gt;• Preso no ponto, o jogador fica a 11 (pés a 10,3), bem acima do platô (8).&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (15,5; 11,5): Definir Por Angulo ligado, ângulo 0, comprimento 18, velocidade 2,5, pausa 1." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="340.0" width="600.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Passo 2 — Esperar o ponto"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 2 — Esperar o ponto" style="text;html=1;strokeColor=none;fill