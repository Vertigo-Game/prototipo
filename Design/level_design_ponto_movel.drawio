fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="118.0" y="206.0" as="sourcePoint"/><mxPoint x="120.0" y="134.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="carona" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="136.0" as="sourcePoint"/><mxPoint x="290.0" y="136.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="pula" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="302.0" y="126.0" as="sourcePoint"/><mxPoint x="340.0" y="86.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="dash" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340.0" y="86.0" as="sourcePoint"/><mxPoint x="446.0" y="178.0" as="targetPoint"/><Array as="points"><mxPoint x="420.0" y="86.0"/></Array></mxGeometry></mxCell><mxCell id="c56" value="6,5" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300.0" y="220.0" as="sourcePoint"/><mxPoint x="430.0" y="220.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600.0" y="146.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Objetivo:&lt;/b&gt; Combinar com o dash: o trilho acaba cedo e só pulo + dash a partir do ponto chega à borda.&lt;br&gt;&lt;br&gt;• Início chão 6 (0–5), vão com espinhos (6–19), chegada chão 8 (20–33).&lt;br&gt;• Do fim do trilho até a chegada são 6,5, saindo 3 acima dela: só o pulo chega a ~4; com o dash (+3) passa.&lt;br&gt;• Pegar o ponto devolve o dash, então mesmo quem usou o dash antes consegue.&lt;br&gt;• Fogueira na chegada: ponto de volta antes do 4c e do 4d.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (9; 11,5): Definir Por Angulo ligado, ângulo 0, comprimento 9, velocidade 2,5, pausa 0,5.&lt;br&gt;• Fogueira (checkpoint) no chão em x 30.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="380.0" width="680.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="Passo 4c — Subir no ponto e quicar no inimigo"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 4c — Subir no ponto e quicar no inimigo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="520.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="520.0" height="440.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="470.0" as="targetPoi