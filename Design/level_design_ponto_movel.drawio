 y="172.0" width="16.0" height="18.0" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="113.0" y="302.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c46" value="espera descer" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="156.0" y="302.0" as="sourcePoint"/><mxPoint x="222.0" y="262.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="sobe" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="218.0" y="262.0" as="sourcePoint"/><mxPoint x="218.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="pula →" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="236.0" y="106.0" as="sourcePoint"/><mxPoint x="310.0" y="166.0" as="targetPoint"/><Array as="points"><mxPoint x="280.0" y="90.0"/></Array></mxGeometry></mxCell><mxCell id="c49" value="espinhos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="174.0" y="366.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c50" value="fora do alcance" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="242.0" y="74.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c51" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420.0" y="142.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Objetivo:&lt;/b&gt; Trilho vertical: no alto o ponto sai do alcance. O jogador aprende a esperar ele descer. Primeiros espinhos.&lt;br&gt;&lt;br&gt;• Borda esquerda chão 5 (0–6), poço com espinhos (7–12), torre chão 12 (13–25).&lt;br&gt;• Na ponta de baixo o ponto fica a 4,5 da beirada; na de cima, a 11,4 (fora do alcance).&lt;br&gt;• No alto, preso (16), o jogador está acima da torre (12): pular para a direita e cair nela.&lt;br&gt;• Fogueira em cima da torre: a partir daqui erros custam a vida.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (10; 12,5): Definir Por Angulo ligado, ângulo 90, comprimento 8, velocidade 2, pausa 1,2.&lt;br&gt;• Fogueira (checkpoint) no chão em x 22.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="460.0" width="560.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="Passo 3 — Carona longa"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 3 — Carona longa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="800.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="800.0" height="320.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locke