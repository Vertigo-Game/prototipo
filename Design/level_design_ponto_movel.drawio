height="18.0" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;html=1;fillColor=#3D6FD6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="93.0" y="282.0" width="14.0" height="28.0" as="geometry"/></mxCell><mxCell id="c56" value="inimigo" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="286.0" as="sourcePoint"/><mxPoint x="202.0" y="238.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="quique" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="214.0" y="214.0" as="sourcePoint"/><mxPoint x="250.0" y="146.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="vento →" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250.0" y="146.0" as="sourcePoint"/><mxPoint x="450.0" y="194.0" as="targetPoint"/><Array as="points"><mxPoint x="350.0" y="126.0"/></Array></mxGeometry></mxCell><mxCell id="c59" value="10" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="270.0" as="sourcePoint"/><mxPoint x="410.0" y="270.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620.0" y="166.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Objetivo:&lt;/b&gt; Quicar no inimigo para dentro de uma faixa de vento lateral, que leva o jogador até a chegada.&lt;br&gt;&lt;br&gt;• Início chão 6 (0–5), vão com espinhos (6–18), chegada chão 11 (19–35).&lt;br&gt;• O inimigo (9; 10) está a 4,8 da beirada. O quique sobe até ~14,6.&lt;br&gt;• Sem vento, o quique anda ~4 para o lado e cai nos espinhos.&lt;br&gt;• A faixa de vento (esquerda → direita, x 8 a 20, y 13 a 16) pega o alto do quique e leva o jogador ~12 para a direita, até a chegada.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• Inimigo parado (prefab EnemyHookPoint) em (9; 10).&lt;br&gt;• Fogueira (checkpoint) no chão em x 32.&lt;br&gt;• Vento Vento_Lateral (prefab WindArea) em (8; 14,5): Origin Esquerda → Direita, width 12, height 3, strength 30, launch speed 12, max speed 15.&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="460.0" width="720.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p19" name="Passo 16 — Prova 3: o desfiladeiro"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 16 — Prova 3: o desfiladeiro" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="960.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="960.0" height="520.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x