cePoint"/><mxPoint x="720.0" y="530.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="" style="endArrow=classic;html=1;strokeColor=#8A94A6;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790.0" y="560.0" as="sourcePoint"/><mxPoint x="110.0" y="610.0" as="targetPoint"/><Array as="points"><mxPoint x="790.0" y="585.0"/><mxPoint x="110.0" y="585.0"/></Array></mxGeometry></mxCell><mxCell id="c59" value="" style="endArrow=classic;html=1;strokeColor=#8A94A6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="640.0" as="sourcePoint"/><mxPoint x="210.0" y="640.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="" style="endArrow=classic;html=1;strokeColor=#8A94A6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="640.0" as="sourcePoint"/><mxPoint x="380.0" y="640.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="" style="endArrow=classic;html=1;strokeColor=#8A94A6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="640.0" as="sourcePoint"/><mxPoint x="550.0" y="640.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="" style="endArrow=classic;html=1;strokeColor=#8A94A6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690.0" y="640.0" as="sourcePoint"/><mxPoint x="720.0" y="640.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="&lt;b&gt;Números do jogo usados nos desenhos&lt;/b&gt; (1 quadrado = 1 tile)&lt;br&gt;• Pulo: sobe 2,4; pulo + dash: ~7,6 na mesma altura&lt;br&gt;• Gancho: alcance 5&lt;br&gt;• Pedras e pontos móveis: o jogador fica parado, preso pelas mãos (0,5 acima do centro), e o vento não age; sai com pulo ou dash&lt;br&gt;• Vento: lateral leva o jogador a 12–16 por segundo; corrente para cima sobe ~12 por segundo e, ao sair no topo, ainda sobe ~2,3&lt;br&gt;• Quique no inimigo: sobe ~4,6 acima dele&lt;br&gt;• Degrau automático: 1 tile; tela: ~18 × 10 tiles&lt;br&gt;• Coordenadas locais de cada passo: (0; 0) é o canto de baixo à esquerda do desenho. Some à origem que escolher na cena." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="40.0" y="730.0" width="820.0" height="160.0" as="geometry"/></mxCell><mxCell id="c64" value="" style="rounded=0;html=1;fillColor=#6B6577;strokeColor=#8A94A6;" vertex="1" parent="1"><mxGeometry x="40.0" y="910.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c65" value="rocha" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="64.0" y="910.0" width="80.0" height="18.0" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=0;html=1;fillColor=#F7FAFD;strokeColor=#8A94A6;" vertex="1" parent="1"><mxGeometry x="122.0" y="910.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c67" value="neve (visual)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="146.0" y="910.0" width="80.0" height="18.0" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=0;html=1;fillColor=#D9483B;strokeColor=#8A94A6;" vertex="1" parent="1"><mxGeometry x="204.0" y="910.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c69" value="espinho" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="228.0" y="910.0" width="80.0" height="18.0" as="geometry"/></mxCell><mxCell id="c70" value="" style="rounded=0;html=1;fillColor=#F2C94C;strokeColor=#8A94A6;" vertex="1" parent="1"><mxGeometry x="286.0" y="910.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="c71" value="ponto móvel" style="text;html=1;strokeColor=none;fillColor=none;align=left;ve