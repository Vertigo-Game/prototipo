rcePoint"/><mxPoint x="350.0" y="266.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c98" value="inimigo" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="366.0" y="258.0" as="sourcePoint"/><mxPoint x="398.0" y="226.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c99" value="quique" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410.0" y="200.0" as="sourcePoint"/><mxPoint x="450.0" y="138.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c100" value="pedra" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="138.0" as="sourcePoint"/><mxPoint x="512.0" y="116.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c101" value="pula" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="528.0" y="114.0" as="sourcePoint"/><mxPoint x="610.0" y="134.0" as="targetPoint"/><Array as="points"><mxPoint x="560.0" y="78.0"/></Array></mxGeometry></mxCell><mxCell id="c102" value="pulo + dash" style="endArrow=classic;html=1;curved=1;dashed=1;strokeColor=#E8590C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E8590C;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="698.0" y="130.0" as="sourcePoint"/><mxPoint x="840.0" y="134.0" as="targetPoint"/><Array as="points"><mxPoint x="760.0" y="98.0"/></Array></mxGeometry></mxCell><mxCell id="c103" value="6" style="endArrow=block;startArrow=block;endSize=4;startSize=4;html=1;strokeColor=#4B5563;fontSize=11;fontColor=#4B5563;labelBackgroundColor=#DCE6F1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="180.0" as="sourcePoint"/><mxPoint x="830.0" y="180.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c104" value="pedra fixa" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="562.0" y="82.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c105" value="inimigo móvel" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420.0" y="178.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c106" value="fogueira" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="882.0" y="98.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c107" value="espinhos em todo o vão" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310.0" y="506.0" width="160.0" height="16.0" as="geometry"/></mxCell><mxCell id="c108" value="&lt;b&gt;Objetivo:&lt;/b&gt; Tudo em sequência: corda, ponto móvel, inimigo móvel, pedra fixa e um vão de pulo + dash até a fogueira.&lt;br&gt;&lt;br&gt;• Início chão 4 com fogueira (0–5); laje (2–5, 14–15) segurando a corda em x 4; vão com espinhos (6–39); bordas chão 22 (28–33 e 40–47).&lt;br&gt;• Do alto da corda, A está a 3,9; do chão, a 12,6.&lt;br&gt;• Na ponta direita de A, o inimigo móvel (18,5 a 24) só está ao alcance na metade esquerda da rota (até x 21).&lt;br&gt;• Durante o quique, mirar na pedra fixa (24,5; 24): no caminho ela passa a 3,8. Da pedra, pulo para a direita até a borda.&lt;br&gt;• Fim: vão de 6 entre as bordas, só com pulo + dash. Fogueira no fim.&lt;br&gt;&lt;br&gt;&lt;b&gt;Montagem:&lt;/b&gt;&lt;br&gt;• PontoMovel (prefab PontoMovel, Stop At Anchor ligado) em (11,5; 17): Definir Por Angulo ligado, ângulo 0, comprimento 10, velocidade 3, pausa 0,6.&lt;br&gt;• Pedra fixa (prefab FixedHookPoint) em (24,5; 24).&lt;br&gt;• Inimigo móvel (prefab InimigoMovel) em (21,25; 18,5): por ângulo, ângulo 0, comprimento 5,5, velocidade 2, trilho desligado.&lt;br&gt;• Fogueira (checkpoint) no chão em x 1.&lt;br&gt;• Fogueira (checkpoint) no chão em x 45.&lt;br&gt;• Corda no tilemap rope_climb, coluna x 4, de y 5 a 13 (o tilemap precisa do componente Corda).&lt;br&gt;• Espinhos no tilemap spike_groupo/spikes, nas células marcadas em vermelho." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="30.0" y="620.0" width="960.0" height="230.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="Passo 11 — Brisa a favor"><mxGraphModel grid="1" gridSize="20" guides="1" page="0" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Passo 11 — Brisa a favor" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="-18.0" width="600.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#DCE6F1;strokeColor=#A9B9CC;locked=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="600.0" height="280.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#A9B9CC;strokeWidth=1;locked=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="30.0" as="sourcePoint"/><mxPoint x="30.0" y="310.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="0" style="text;html=1;strokeColor=none;fillColor=none;ali