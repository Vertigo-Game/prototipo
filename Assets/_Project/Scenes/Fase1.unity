  m_Script: {fileID: 11500000, guid: a583c9ef4a4b7ec4b9e5cc7e3f4f09b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Vertigo.Gameplay.Placa
  texto: "Quem passa por aqui quase nunca volta. Eu voltei, ent\xE3o escuta.\n\nPula
    no ESPA\xC7O. No ar, SHIFT d\xE1 um tranco, mas s\xF3 um, depois precisa pisar
    em ch\xE3o firme.\n\nO gancho prende onde o MOUSE apontar. Clica de novo pra
    soltar, sem vergonha nenhuma.\n\nO frio n\xE3o perdoa. Chega perto do fogo pra
    se aquecer e aperta E pra acender a fogueira.\n\nEscorregou? R e tenta de novo.
    A montanha n\xE3o vai a lugar nenhum."
  caixa: {fileID: 1194860842}
  aviso: {fileID: 850797346}
  deslocamentoAviso: {x: 0, y: 1.25}
  duracaoFadeAviso: 0.25
